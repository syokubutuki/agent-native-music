  "swing": 0,
  "beatsPerBar": 4,
  "bars": 22,
  "sections": [
    {"bar":0,"label":"イントロ"},
    {"bar":2,"label":"Aメロ"},
    {"bar":10,"label":"Bメロ"},
    {"bar":14,"label":"サビ"}
  ],
  "lyrics": [
    {"beat":8,"text":"よあけのまえの しずかなそらに"},
    {"beat":16,"text":"ちいさなゆめを にぎりしめて"},
    {"beat":24,"text":"かぜがせなかを おしてくれたら"},
    {"beat":32,"text":"あしたのほうへ ふみだしてみる"},
    {"beat":40,"text":"まだとどかなくても"},
    {"beat":48,"text":"いまをかけてゆく"},
    {"beat":56,"text":"はしれ はしれ ひかりのほうへ"},
    {"beat":64,"text":"なみだもかぜに ほどけてゆく"},
    {"beat":72,"text":"さあ いまなら とべるはずさ"},
    {"beat":80,"text":"きみとみつけた あさのなかへ"}
  ],
