{
  "format": "anm-score/1",
  "id": "zenbu-suuji",
  "version": 1,
  "order": 5,
  "title": "ぜんぶ すうじ",
  "description": "曲案D: 人生を数字で早口に言い切る曲。サビで急に半分の速さになり、1小節だけ無音になり、最後のサビで転調する。歌のメロディは仮の電子音。",
  "changes": "現代のボカロ寄りに作り直した案。仕掛け: 16分音符の超高速ラップ、サビで急なハーフタイム、1小節の無音、最後のサビの転調(+2)。歌詞は「ぼくは すうじ」の反復。",
  "bpm": 110,
  "swing": 0,
  "beatsPerBar": 4,
  "bars": 35,
  "sections": [
    {"bar":0,"label":"イントロ"},
    {"bar":2,"label":"数字ラップ"},
    {"bar":10,"label":"かぞえあげ"},
    {"bar":14,"label":"サビ(半分の速さ)"},
    {"bar":22,"label":"しょうもない数字"},
    {"bar":26,"label":"無音"},
    {"bar":27,"label":"サビ(転調)"}
  ],
  "lyrics": [
    {"beat":8,"text":"ひゃくにじゅうごせんちの ごじゅうにきろ"},
    {"beat":12,"text":"ろくじにおきて ななじにでかけた"},
    {"beat":16,"text":"ふぁぼのかず さんびゃくじゅうに"},
    {"beat":20,"text":"ざんだかは ごせんえんと ごえんだま"},
    {"beat":24,"text":"ともだちは にじゅうさんにん"},
    {"beat":28,"text":"ほんとは さんにん いや ひとり"},
    {"beat":32,"text":"こいびとは ぜろ かたおもいは いち"},
    {"beat":36,"text":"あいしてるの かいすう ぜろ"},
    {"beat":40,"text":"いち に さん し"},
    {"beat":44,"text":"ご ろく しち はち"},
    {"beat":48,"text":"きゅう じゅう"},
    {"beat":52,"text":"ぼくを かぞえて"},
    {"beat":56,"text":"ぼくは すうじ ぼくは すうじ"},
    {"beat":64,"text":"なまえの ばしょに すうじで ぼくを よんで"},
    {"beat":72,"text":"ひゃくてん まんてん ぜろてん どれでも ぼくは ぼくじゃない"},
    {"beat":80,"text":"ぼくは すうじ ぼくは すうじ ぜろ"},
    {"beat":88,"text":"ねたじかんは よんじかん"},
    {"beat":92,"text":"ごはんは にかい おやつは さんかい"},
    {"beat":96,"text":"つかれたのは まいにち ぜんぶ"},
    {"beat":100,"text":"いいねの かずで ぼくを はかる"},
    {"beat":104,"text":"ぜろ"},
    {"beat":108,"text":"ぼくは すうじ ぼくは すうじ"},
    {"beat":116,"text":"なまえの ばしょに すうじで ぼくを よんで"},
    {"beat":124,"text":"ひゃくてん まんてん ぜろてん どれでも ぼくは ぼくじゃない"},
    {"beat":132,"text":"ぼくは すうじ もういちど すうじ"}
  ],
