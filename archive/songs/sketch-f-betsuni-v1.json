{
  "format": "anm-score/1",
  "id": "betsuni",
  "version": 1,
  "order": 1,
  "title": "べつに",
  "description": "曲案F: 強がりの口癖を重ねるボカラップ。ほんとは全然平気じゃない。サビは歌う。歌のメロディは仮の電子音。",
  "changes": "「ぜんぶ すうじ」のラップの型(超高速・同じ高さ・言い切り)を残し、題材を口癖に変えた案。4小節ごとに最後の1拍を全部止める「キメ」を追加。",
  "bpm": 112,
  "swing": 0,
  "beatsPerBar": 4,
  "bars": 29,
  "sections": [
    {"bar":0,"label":"イントロ"},
    {"bar":2,"label":"ラップ"},
    {"bar":10,"label":"せりあげ"},
    {"bar":12,"label":"サビ(歌)"},
    {"bar":20,"label":"ラップ2"},
    {"bar":24,"label":"無音"},
    {"bar":25,"label":"サビ(転調)"}
  ],
  "lyrics": [
    {"beat":8,"text":"べつに べつに べつに きにして ない"},
    {"beat":12,"text":"どうせ どうせ どうせ きたいしてない"},
    {"beat":16,"text":"だけど だけど だけど あやまらない"},
    {"beat":20,"text":"まあいいや まあいいや もういいよ"},
    {"beat":24,"text":"たんじょうびの ひも べつに"},
    {"beat":28,"text":"わすれられても べつに"},
    {"beat":32,"text":"ろうそくに ひを つけて ふいた"},
    {"beat":36,"text":"ねがいごとは ひとつ だけ"},
    {"beat":40,"text":"ほんとは ほんとは ほんとは ほんとは"},
    {"beat":44,"text":"ほんとは ね"},
    {"beat":48,"text":"べつに べつに ほんとは くやしい"},
    {"beat":56,"text":"どうせ むだだよ わらえば いいさ"},
    {"beat":64,"text":"きいてほしいと いえなくて べつに べつに べつに だよ"},
    {"beat":72,"text":"べつに べつに だいすき だよ"},
    {"beat":80,"text":"ろうそくの けむり めに しみて"},
    {"beat":84,"text":"べつに べつに なみだじゃない"},
    {"beat":88,"text":"ひとりで うたう おめでとう"},
    {"beat":92,"text":"だれも いない へやに ひびく"},
    {"beat":96,"text":"べつに"},
    {"beat":100,"text":"べつに べつに ほんとは くやしい"},
    {"beat":108,"text":"べつに べつに だいすき だよ"}
  ],
