{
  "format": "anm-score/1",
  "id": "koe-wa-zenbu",
  "version": 1,
  "order": 2,
  "title": "こえは ぜんぶ あげる",
  "description": "曲案E: しゃべるのが面倒で、告白も謝罪も機械に歌わせる人の歌。7拍子で、ロボットのような単音のぼそぼそから始まる。歌のメロディは仮の電子音。",
  "changes": "現代のボカロ寄りに作り直した案。仕掛け: 7拍子(4+3のかたまり)、同じ高さのぼそぼそ声、1小節だけの無伴奏、最後のサビの転調(+2)、急に静まる終わり。",
  "bpm": 100,
  "swing": 0,
  "beatsPerBar": 7,
  "bars": 18,
  "sections": [
    {"bar":0,"label":"イントロ"},
    {"bar":2,"label":"ぼそぼそ"},
    {"bar":6,"label":"おもてに出る"},
    {"bar":8,"label":"サビ"},
    {"bar":12,"label":"無伴奏"},
    {"bar":13,"label":"サビ(転調)"},
    {"bar":17,"label":"おやすみ"}
  ],
  "lyrics": [
    {"beat":14,"text":"ことばは ぜんぶ おまえに あげる"},
    {"beat":21,"text":"ぼくは なにも いわなくていい"},
    {"beat":28,"text":"こくはくも ごめんなさいも"},
    {"beat":35,"text":"おまえの こえで たのんだよ"},
    {"beat":42,"text":"まちがえたら ぜんぶ おまえの せい"},
    {"beat":56,"text":"あいしてる ごめんなさい"},
    {"beat":70,"text":"わらうのも なくのも ぜんぶ おまえの こえ"},
    {"beat":84,"text":"ぼくのこえは どこ"},
    {"beat":91,"text":"あいしてる ごめんなさい"},
    {"beat":105,"text":"わらうのも なくのも もう ぼくの こえ わすれた"},
    {"beat":119,"text":"おやすみ おまえ"}
  ],
